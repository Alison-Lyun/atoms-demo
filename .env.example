# Never commit .env.local. Configure these in Vercel too before deploying.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=
# Optional: "responses" for OpenAI Responses API; default "chat" for compatible chat endpoints.
MODEL_API_MODE=chat
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# local is for one local Node process. Cloud deployment requires supabase.
STORAGE_MODE=local
# Enables clearly labelled fixtures for development, never real AI generation.
ENABLE_DEV_FIXTURES=false
MAX_GENERATIONS_PER_HOUR=20
# 本机 npm run build && npm start 验收时显式开启。Vercel 永不允许磁盘持久化。
ATOMS_ALLOW_LOCAL_STORAGE=false
# 可选：本地 JSON 存储目录，默认项目内 .data/
LOCAL_DATA_DIR=
